# ---- Database ----
MONGODB_URI=your-mongodb-connection-string

# ---- Dashboard auth ----
ADMIN_PASSWORD=your-strong-admin-password      # entered on /login
AUTH_SECRET=a-long-random-secret               # signs/verifies the session cookie
# generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# ---- Cloudinary (file uploads) ----
CLOUDINARY_CLOUD_NAME=your-cloud-name              # server-side cloud name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name  # same value, exposed to the upload widget
CLOUDINARY_API_KEY=your-api-key                    # server only
CLOUDINARY_API_SECRET=your-api-secret              # server only — never expose

# ---- Contact form (Resend, server-side) ----
RESEND_API_KEY=your-resend-api-key                  # server only — never expose
RESEND_FROM=Portfolio <onboarding@resend.dev>       # verified sender (use your own verified domain)
CONTACT_TO=azzimaina@gmail.com                      # inbox that submissions are delivered to

# ---- Legacy blog manage key (retired from the write path; kept for reference) ----
# MANAGE_KEY=your-secret-manage-key
